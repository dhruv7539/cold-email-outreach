# Copy to .env.local and fill in. None of these are the user's API keys; those
# are entered in the app and encrypted per user.

# Postgres (Neon or Supabase free tier both work).
DATABASE_URL=postgres://user:password@host/dbname

# 32 bytes, base64. Encrypts users' stored API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Public base URL, used to build magic-link and sheet-pairing URLs.
APP_URL=http://localhost:3000

# Transactional email for sign-in links only (never outreach). Optional in dev:
# without it, the sign-in link is printed to the server console.
RESEND_API_KEY=
MAGIC_LINK_FROM=Outreach Hub <login@yourdomain.com>

# The template Google Sheet users copy. Ships with Code.gs + Bridge.gs bound.
TEMPLATE_SHEET_URL=
